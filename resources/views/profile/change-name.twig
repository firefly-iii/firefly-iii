{% extends './layout/default' %}

{% block breadcrumbs %}
    {{ Breadcrumbs.render(Route.getCurrentRoute.getName) }}
{% endblock %}

{% block content %}
    <form method="POST" action="{{ route('profile.change-name.post') }}" accept-charset="UTF-8" class="form-horizontal" id="change-name">
        <input name="_token" type="hidden" value="{{ csrf_token() }}">

        <div class="row">
            <div class="col-lg-6 col-md-12 col-sm-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">{{ 'change_your_name'|_ }}</h3>
                    </div>
                    <div class="box-body">

                        {% if errors|length > 0 %}
                            <ul>
                                {% for error in errors.all %}
                                    <li class="text-danger">{{ error }}</li>
                                {% endfor %}
                            </ul>

                        {% endif %}

                        <div class="form-group">
                            <label for="name" class="col-sm-4 control-label">{{ trans('firefly.new_display_name') }}</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" id="name" placeholder="{{ 'new_display_name'|_ }}" spellcheck="false"
                                       value="{{ old('name')|default(name) }}"
                                       maxlength="255"
                                       name="name">
                            </div>
                        </div>

                    </div>
                    <div class="box-footer">
                        <button type="submit" class="btn btn-success pull-right">{{ 'change_your_name'|_ }}</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
