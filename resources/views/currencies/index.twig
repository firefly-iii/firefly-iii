{% extends './layout/default' %}

{% block header_actions %}
    <a class="btn btn-success content-header-actions" href="{{ route('currencies.create') }}">{{ 'create_currency'|_ }}</a>
    {# Covers the natural gap between .content-header and the table (box border + box-body
       padding); see the comment on .currencies-header-gap-fill in firefly.css. #}
    <div class="currencies-header-gap-fill"></div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-12 col-sm-12 col-md-12">
            <div class="box">
                <div class="box-body">
                    {% if currencies|length > 0 %}
                        <div style="padding-left:8px;">
                            {{ currencies.links('pagination.bootstrap-4')|raw }}
                        </div>
                        <table class="table table-hover currencies-table">
                            <thead>
                            <tr>
                                <th class="currencies-table__index">#</th>
                                <th>{{ 'currency'|_ }}</th>
                                <th>{{ 'currency_country'|_ }}</th>
                                <th class="currencies-table__enabled">{{ 'currency_enabled_column'|_ }}</th>
                                {% if isOwner %}
                                    <th class="currencies-table__actions">{{ 'actions'|_ }}</th>
                                {% endif %}
                            </tr>
                            </thead>
                            <tbody>
                            {% for currency in currencies %}
                                <tr{% if not currency.userGroupEnabled %} class="text-muted"{% endif %}>
                                    <td class="currencies-table__index">
                                        {{ (currencies.currentPage() - 1) * currencies.perPage() + loop.index }}
                                    </td>
                                    <td>
                                        {{ currency.name }} ({{ currency.code }}) ({{ currency.symbol|raw }})
                                        {% if currency.id == primaryCurrency.id %}
                                            <span class="label label-success" id="default-currency">{{ 'primary_currency_button'|_ }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ currency.country_name }}</td>
                                    <td class="currencies-table__enabled">
                                        <label class="switch" title="{{ (currency.userGroupEnabled ? 'disable_currency' : 'enable_currency')|_ }}">
                                            <input type="checkbox" class="currency-toggle" data-code="{{ currency.code }}"
                                                   {% if currency.userGroupEnabled %}checked="checked"{% endif %}>
                                            <span class="switch__track" aria-hidden="true"></span>
                                            <span class="sr-only">
                                                {{ (currency.userGroupEnabled ? 'disable_currency' : 'enable_currency')|_ }}
                                                {{ currency.code }}
                                            </span>
                                        </label>
                                    </td>
                                    {% if isOwner %}
                                        <td class="currencies-table__actions">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-default btn-xs dropdown-toggle" data-toggle="dropdown"
                                                        aria-haspopup="true" aria-expanded="false"
                                                        title="{{ 'actions'|_ }}">
                                                    <span class="fa fa-ellipsis-h"></span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-right" role="menu">
                                                    {% if currency.id != primaryCurrency.id %}
                                                        <li>
                                                            <a href="#" class="make_default" data-code="{{ currency.code }}">
                                                                <span class="fa fa-fw fa-star"></span> {{ 'make_default_currency'|_ }}
                                                            </a>
                                                        </li>
                                                        <li class="divider"></li>
                                                    {% endif %}
                                                    <li>
                                                        <a href="{{ route('currencies.edit',currency.id) }}">
                                                            <span class="fa fa-fw fa-pencil"></span> {{ 'edit'|_ }}
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a href="{{ route('currencies.delete',currency.id) }}">
                                                            <span class="fa fa-fw fa-trash"></span> {{ 'delete'|_ }}
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <div style="padding-left:8px;">
                            {{ currencies.links('pagination.bootstrap-4')|raw }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    <script type="text/javascript" nonce="{{ JS_NONCE }}">
        var redirectUrl = "{{ route('currencies.index') }}";
        var updateCurrencyUrl = "{{ route('api.v1.currencies.update', ['']) }}";
    </script>
    <script type="text/javascript" src="v1/js/ff/currencies/index.js?v={{ FF_VERSION }}" nonce="{{ JS_NONCE }}"></script>
{% endblock %}
