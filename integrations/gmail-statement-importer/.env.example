# Copy to .env and set every required secret before starting the service.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Mount a Google OAuth client-secrets JSON file and set its container path.
GOOGLE_OAUTH_CLIENT_SECRETS=/run/secrets/google-oauth-client.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8082/oauth/callback

# Exact sender addresses, separated by commas. Only PDFs from these senders
# will be considered. Do not include a Gmail password or app password here.
GMAIL_ALLOWED_SENDERS=

DATABASE_PATH=/data/importer.sqlite3
POLL_INTERVAL_SECONDS=60
MAX_ATTACHMENT_BYTES=20000000
